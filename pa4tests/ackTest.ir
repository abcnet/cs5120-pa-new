 (FUNC
  _IAck_iii
  (SEQ
   (MOVE (TEMP m_Ack) (TEMP _ARG0))
   (MOVE (TEMP n_Ack) (TEMP _ARG1))
   (CJUMP (EQ (TEMP m_Ack) (CONST 0)) L_true_23)
   (JUMP (NAME L_false_24))
   (LABEL L_true_23)
   (MOVE (TEMP _RET0) (ADD (TEMP n_Ack) (CONST 1)))
   (RETURN)
   (JUMP (NAME L_end_25))
   (LABEL L_false_24)
   (CJUMP (EQ (TEMP n_Ack) (CONST 0)) L_true_28)
   (JUMP (NAME L_false_29))
   (LABEL L_true_28)
   (MOVE (TEMP _RET0)
    (CALL (NAME _IAck_iii) (SUB (TEMP m_Ack) (CONST 1)) (CONST 1)))
   (RETURN)
   (JUMP (NAME L_end_30))
   (LABEL L_false_29)
   (MOVE (TEMP __var_45)
    (CALL (NAME _IAck_iii) (TEMP m_Ack) (SUB (TEMP n_Ack) (CONST 1))))
   (MOVE (TEMP _RET0)
    (CALL (NAME _IAck_iii) (SUB (TEMP m_Ack) (CONST 1)) (TEMP __var_45)))
   (RETURN)
   (LABEL L_end_30)
   (LABEL L_end_25)
   (RETURN))))
