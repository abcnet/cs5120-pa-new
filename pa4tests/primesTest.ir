   (LABEL L_9)
   (CJUMP (NEQ (TEMP a_gcd) (CONST 0)) L_true_0 L_false_1)
   (LABEL L_true_0)
   (SEQ
    (SEQ
     (CJUMP (LT (TEMP a_gcd) (TEMP b_gcd)) L_true_2 L_false_3)
     (LABEL L_true_2)
     (MOVE
      (TEMP b_gcd)
      (ESEQ
       (SEQ
        (MOVE (TEMP _LEFT5) (TEMP b_gcd))
        (MOVE (TEMP _RIGHT6) (TEMP a_gcd)))
       (SUB (TEMP _LEFT5) (TEMP _RIGHT6))))
     (JUMP (NAME L_end_4))
     (LABEL L_false_3)
     (MOVE
      (TEMP a_gcd)
      (ESEQ
