        (MOVE (TEMP _LEFT7) (TEMP a_gcd))
        (MOVE (TEMP _RIGHT8) (TEMP b_gcd)))
       (SUB (TEMP _LEFT7) (TEMP _RIGHT8))))
     (LABEL L_end_4)))
   (JUMP (NAME L_9))
   (LABEL L_false_1)
   (MOVE (TEMP _RET0) (TEMP b_gcd))
   (RETURN)
   (RETURN)))
