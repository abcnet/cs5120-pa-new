 (FUNC
  _Igcd_iii
  (SEQ
   (MOVE (TEMP a_gcd) (TEMP _ARG0))
   (MOVE (TEMP b_gcd) (TEMP _ARG1))
   (LABEL L_406)
   (CJUMP (NEQ (TEMP a_gcd) (CONST 0)) L_true_397)
   (JUMP (NAME L_false_398))
   (LABEL L_true_397)
   (CJUMP (LT (TEMP a_gcd) (TEMP b_gcd)) L_true_399)
   (JUMP (NAME L_false_400))
   (LABEL L_true_399)
   (MOVE (TEMP b_gcd) (SUB (TEMP b_gcd) (TEMP a_gcd)))
   (JUMP (NAME L_end_401))
   (LABEL L_false_400)
   (MOVE (TEMP a_gcd) (SUB (TEMP a_gcd) (TEMP b_gcd)))
   (LABEL L_end_401)
   (JUMP (NAME L_406))
   (LABEL L_false_398)
   (MOVE (TEMP _RET0) (TEMP b_gcd))
   (RETURN)
   (RETURN)))
