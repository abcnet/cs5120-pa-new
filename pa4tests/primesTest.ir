      (MUL (TEMP _LEFT) (TEMP _RIGHT)))
     (TEMP n))
    L_true_92
    L_false_93)
   (LABEL L_true_92)
   (SEQ
    (SEQ
     (CJUMP (NEQ (CALL (NAME _Igcd_iii) (TEMP i) (TEMP n)) (CONST 1)) L_true_94
      L_false_95)
     (LABEL L_true_94)
     (SEQ (MOVE (TEMP _RET0) (CONST 0)) (RETURN))
     (LABEL L_false_95))
    (MOVE
     (TEMP i)
     (ESEQ
      (SEQ (MOVE (TEMP _LEFT) (TEMP i)) (MOVE (TEMP _RIGHT) (CONST 1)))
      (ADD (TEMP _LEFT) (TEMP _RIGHT)))))
   (JUMP (NAME L_96))
   (LABEL L_false_93)
   (MOVE (TEMP _RET0) (CONST 1))
   (RETURN)
