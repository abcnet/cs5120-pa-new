   (LABEL L_true_97)
   (SEQ
    (SEQ
     (CJUMP (CALL (NAME _Iisprime_bi) (TEMP a)) L_true_99 L_false_100)
     (LABEL L_true_99)
     (MOVE (TEMP largest) (TEMP a))
     (LABEL L_false_100))
    (MOVE
     (TEMP a)
     (ESEQ
      (SEQ (MOVE (TEMP _LEFT) (TEMP a)) (MOVE (TEMP _RIGHT) (CONST 1)))
      (ADD (TEMP _LEFT) (TEMP _RIGHT)))))
   (JUMP (NAME L_101))
   (LABEL L_false_98)
   (MOVE (TEMP _RET0) (TEMP largest))
   (RETURN)
   (RETURN)))
