 (FUNC
  _Igcd_iii
  (SEQ
   (MOVE (TEMP a) (TEMP _ARG0))
   (MOVE (TEMP b) (TEMP _ARG1))
   (LABEL L_91)
   (CJUMP (NEQ (TEMP a) (CONST 0)) L_true_86 L_false_87)
   (LABEL L_true_86)
   (SEQ
    (SEQ
     (CJUMP (LT (TEMP a) (TEMP b)) L_true_88 L_false_89)
     (LABEL L_true_88)
     (MOVE
      (TEMP b)
      (ESEQ
       (SEQ (MOVE (TEMP _LEFT) (TEMP b)) (MOVE (TEMP _RIGHT) (TEMP a)))
       (SUB (TEMP _LEFT) (TEMP _RIGHT))))
     (JUMP (NAME L_end_90))
     (LABEL L_false_89)
     (MOVE
      (TEMP a)
      (ESEQ
       (SEQ (MOVE (TEMP _LEFT) (TEMP a)) (MOVE (TEMP _RIGHT) (TEMP b)))
       (SUB (TEMP _LEFT) (TEMP _RIGHT))))
     (LABEL L_end_90)))
   (JUMP (NAME L_91))
   (LABEL L_false_87)
   (MOVE (TEMP _RET0) (TEMP b))
   (RETURN)
   (RETURN)))
 (FUNC
