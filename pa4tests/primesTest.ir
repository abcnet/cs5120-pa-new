   (LABEL L_true_0)
   (SEQ
    (SEQ
     (CJUMP (LT (TEMP a) (TEMP b)) L_true_2 L_false_3)
     (LABEL L_true_2)
     (MOVE
      (TEMP b)
      (ESEQ
       (SEQ (MOVE (TEMP _LEFT) (TEMP b)) (MOVE (TEMP _RIGHT) (TEMP a)))
       (SUB (TEMP _LEFT) (TEMP _RIGHT))))
     (JUMP (NAME L_end_4))
     (LABEL L_false_3)
     (MOVE
      (TEMP a)
      (ESEQ
       (SEQ (MOVE (TEMP _LEFT) (TEMP a)) (MOVE (TEMP _RIGHT) (TEMP b)))
       (SUB (TEMP _LEFT) (TEMP _RIGHT))))
     (LABEL L_end_4)))
   (JUMP (NAME L_5))
   (LABEL L_false_1)
   (MOVE (TEMP _RET0) (TEMP b))
   (RETURN)
   (RETURN)))
