(COMPUNIT
 fibonacciTest
 (FUNC
  _Ifib_ii
  (SEQ
   (MOVE (TEMP i) (TEMP _ARG0))
   (CJUMP (LT (TEMP i) (CONST 2)) L_true_0 L_false_1)
   (LABEL L_true_0)
   (SEQ (MOVE (TEMP _RET0) (TEMP i)) (RETURN))
   (JUMP (NAME L_end_2))
   (LABEL L_false_1)
   (SEQ
    (MOVE
     (TEMP _RET0)
     (ESEQ
      (SEQ
       (MOVE
        (TEMP _LEFT9)
        (CALL
         (NAME _Ifib_ii)
         (ESEQ
          (SEQ (MOVE (TEMP _LEFT3) (TEMP i)) (MOVE (TEMP _RIGHT4) (CONST 1)))
          (SUB (TEMP _LEFT3) (TEMP _RIGHT4)))))
       (MOVE
        (TEMP _RIGHT10)
        (CALL
         (NAME _Ifib_ii)
         (ESEQ
          (SEQ (MOVE (TEMP _LEFT5) (TEMP i)) (MOVE (TEMP _RIGHT6) (CONST 2)))
          (SUB (TEMP _LEFT5) (TEMP _RIGHT6))))))
      (ADD (TEMP _LEFT9) (TEMP _RIGHT10))))
    (RETURN))
   (LABEL L_end_2)
   (RETURN)))
