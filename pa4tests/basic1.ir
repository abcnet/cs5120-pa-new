(COMPUNIT
 basic1
 (FUNC
  _If_i
  (SEQ
   (MOVE (TEMP y_f) (CONST 5))
   (MOVE (TEMP x_f) (EQ (CONST 6) (CONST 7)))
   (MOVE (TEMP y_f) (CONST 10))
   (CJUMP
    (XOR
     (EQ
      (GT (TEMP y_f) (CONST 10))
      (ESEQ
       (SEQ
        (MOVE (TEMP _var_6) (CONST 0))
        (CJUMP (CONST 0) L_4 L_false_3)
        (LABEL L_4)
        (CJUMP (GT (TEMP y_f) (CONST 8)) L_5 L_false_3)
        (LABEL L_5)
        (MOVE (TEMP _var_6) (CONST 1))
        (LABEL L_false_3))
       (TEMP _var_6)))
     (CONST 1))
    L_true_0
    L_false_1)
   (LABEL L_true_0)
   (SEQ (MOVE (TEMP y_f) (CONST 10)) (MOVE (TEMP y_f) (CONST 20)))
   (JUMP (NAME L_end_2))
   (LABEL L_false_1)
   (SEQ (MOVE (TEMP y_f) (CONST 17)))
   (LABEL L_end_2)
   (MOVE (TEMP _RET0) (CONST 1))
   (RETURN)
   (RETURN))))
(COMPUNIT
 basic1
 (FUNC
  _If_i
  (SEQ
   (MOVE (TEMP y_f) (CONST 5))
   (MOVE (TEMP x_f) (EQ (CONST 6) (CONST 7)))
   (MOVE (TEMP y_f) (CONST 10))
   (MOVE (TEMP _var_7) (GT (TEMP y_f) (CONST 10)))
   (MOVE (TEMP _var_8) (CONST 1))
   (MOVE (TEMP _var_6) (CONST 0))
   (CJUMP (CONST 0) L_4)
   (JUMP (NAME L_false_3))
   (LABEL L_4)
   (CJUMP (GT (TEMP y_f) (CONST 8)) L_5)
   (JUMP (NAME L_false_3))
   (LABEL L_5)
   (MOVE (TEMP _var_6) (CONST 1))
   (LABEL L_false_3)
   (CJUMP (XOR (TEMP _var_8) (EQ (TEMP _var_7) (TEMP _var_6))) L_true_0)
   (JUMP (NAME L_false_1))
   (LABEL L_true_0)
   (MOVE (TEMP y_f) (CONST 10))
   (MOVE (TEMP y_f) (CONST 20))
   (JUMP (NAME L_end_2))
   (LABEL L_false_1)
   (MOVE (TEMP y_f) (CONST 17))
   (LABEL L_end_2)
   (MOVE (TEMP _RET0) (CONST 1))
   (RETURN)
   (RETURN))))
