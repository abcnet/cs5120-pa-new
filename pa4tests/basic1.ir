(COMPUNIT
 basic1
 (FUNC
  _If_i
  (SEQ
   (MOVE (TEMP y) (CONST 5))
   (MOVE
    (TEMP x)
    (ESEQ
     (SEQ
      (MOVE (TEMP var_3) (CONST 0))
      (CJUMP (LT (TEMP y) (CONST 5)) L_1 L_false_0)
      (LABEL L_1)
      (CJUMP (CONST 1) L_2 L_false_0)
      (LABEL L_2)
      (MOVE (TEMP var_3) (CONST 1))
      (LABEL L_false_0))
     (TEMP var_3)))
   (MOVE (TEMP y) (CONST 10))
   (SEQ
    (CJUMP (GT (TEMP y) (CONST 6)) L_6 L_false_5)
    (LABEL L_6)
    (CJUMP (LT (TEMP y) (CONST 7)) L_true_4 L_false_5))
   (LABEL L_true_4)
   (SEQ (MOVE (TEMP y) (CONST 10)) (MOVE (TEMP y) (CONST 20)))
   (LABEL L_false_5)
   (SEQ (MOVE (TEMP y) (CONST 17)))
   (MOVE (TEMP _RET0) (CONST 1))
   (RETURN))))
