 (FUNC
  _IAck_iii
  (SEQ
   (MOVE (TEMP m_Ack) (TEMP _ARG0))
   (MOVE (TEMP n_Ack) (TEMP _ARG1))
   (CJUMP (EQ (TEMP m_Ack) (CONST 0)) L_true_0)
   (JUMP (NAME L_false_1))
   (LABEL L_true_0)
   (MOVE (TEMP _RET0) (ADD (TEMP n_Ack) (CONST 1)))
   (RETURN)
   (JUMP (NAME L_end_2))
   (LABEL L_false_1)
   (CJUMP (EQ (TEMP n_Ack) (CONST 0)) L_true_5)
   (JUMP (NAME L_false_6))
   (LABEL L_true_5)
   (MOVE (TEMP _RET0)
    (CALL (NAME _IAck_iii) (SUB (TEMP m_Ack) (CONST 1)) (CONST 1)))
   (RETURN)
   (JUMP (NAME L_end_7))
   (LABEL L_false_6)
   (MOVE (TEMP __var_22)
    (CALL (NAME _IAck_iii) (TEMP m_Ack) (SUB (TEMP n_Ack) (CONST 1))))
   (MOVE (TEMP _RET0)
    (CALL (NAME _IAck_iii) (SUB (TEMP m_Ack) (CONST 1)) (TEMP __var_22)))
   (RETURN)
   (LABEL L_end_7)
   (LABEL L_end_2)
   (RETURN))))
