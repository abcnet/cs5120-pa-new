(COMPUNIT
 non_commutative_binop_exprs_test
 (FUNC
  _If_iai
  (SEQ
   (MOVE (TEMP a_f) (TEMP _ARG0))
   (MOVE (MEM (ADD (TEMP a_f) (CONST 0)))
    (MUL (MEM (ADD (TEMP a_f) (CONST 0))) (CONST 5)))
   (MOVE (TEMP _RET0) (MEM (ADD (TEMP a_f) (CONST 0))))
   (RETURN)
   (RETURN)))
 (FUNC
  _Ig_iai
  (SEQ
   (MOVE (TEMP a_g) (TEMP _ARG0))
   (MOVE (MEM (ADD (TEMP a_g) (CONST 0)))
    (ADD (MEM (ADD (TEMP a_g) (CONST 0))) (CONST 2)))
   (MOVE (TEMP _RET0) (MEM (ADD (TEMP a_g) (CONST 0))))
   (RETURN)
   (RETURN)))
 (FUNC
  _Imain_paai
  (SEQ
   (MOVE (TEMP args_main) (TEMP _ARG0))
   (MOVE (TEMP _ARR_0) (CALL (NAME _I_alloc_i) (CONST 32)))
   (MOVE (MEM (TEMP _ARR_0)) (CONST 3))
   (MOVE (TEMP _ARR_0) (ADD (TEMP _ARR_0) (CONST 8)))
   (MOVE (MEM (ADD (TEMP _ARR_0) (CONST 0))) (CONST 5))
   (MOVE (MEM (ADD (TEMP _ARR_0) (CONST 8))) (CONST 3))
   (MOVE (MEM (ADD (TEMP _ARR_0) (CONST 16))) (CONST 1))
   (MOVE (TEMP a_main) (TEMP _ARR_0))
   (MOVE (TEMP __var_8) (CALL (NAME _If_iai) (TEMP a_main)))
   (MOVE (TEMP __var_9) (CALL (NAME _Ig_iai) (TEMP a_main)))
   (MOVE (TEMP x_main) (ADD (TEMP __var_8) (TEMP __var_9)))
   (MOVE (TEMP __var_10) (CALL (NAME _Ig_iai) (TEMP a_main)))
   (MOVE (TEMP __var_11) (CALL (NAME _If_iai) (TEMP a_main)))
   (MOVE (TEMP y_main) (ADD (TEMP __var_10) (TEMP __var_11)))
   (MOVE (TEMP __var_13) (CALL (NAME _IunparseInt_aii) (TEMP x_main)))
   (MOVE (TEMP __var_12) (CALL (NAME _Iprintln_pai) (TEMP __var_13)))
   (MOVE (TEMP __var_15) (CALL (NAME _IunparseInt_aii) (TEMP y_main)))
   (MOVE (TEMP __var_14) (CALL (NAME _Iprintln_pai) (TEMP __var_15)))
   (RETURN))))
