// A stub for a Xi CUP specification.
/* Part of code from http://www2.cs.tum.edu/projekte/cup/examples.php */
package zr54.parser;

import java_cup.runtime.*;
import edu.cornell.cs.cs4120.util.*;
import polyglot.util.*; 


parser code {:
    // Connect this parser to a scanner!
    //Lexer s;
    public CodeWriterSExpPrinter printer;
    public parser(CodeWriterSExpPrinter printer){ this.printer=printer; }
:}

/* define how to connect to the scanner! */
//init with {: s.init(); :};
//scan with {: return s.next_token(); :};

// You might want to add types to these declarations.
terminal IDENTIFIER, INTEGER_LITERAL, STRING_LITERAL, CHARACTER_LITERAL, BOOLEAN_LITERAL, LPAREN, RPAREN, LBRACE, RBRACE, LBRACK, RBRACK, SEMICOLON, COMMA, COLON, EQ, GT, LT, NOT, MULT, PLUS, MINUS, AND, OR, MOD, IF, EQEQ, GTEQ, LTEQ, NOTEQ, HIGHMULT, INT, BOOL, ELSE, WHILE, LENGTH, RETURN, DIV, USE, UNDERSCORE;

// You might want to add types to these declarations.
nonterminal AstNode program, singleUse, uses, arrayType, type, argumentWithType, argumentsWithType, argument, functionReturnType , multipleStatements, statement, functionCall, typesList, assignment, ifStatement, whileStatement, operator, expression, oneOrMorestatements, brackets, variables, variable, expressions, methods, method, arrayLiteral, optionalSemicolon;
// Add more nonterminals here...




precedence nonassoc ELSE;
precedence nonassoc EQ;
precedence left OR;
precedence left AND;
precedence left EQEQ, NOTEQ;
precedence left LT, LTEQ, GTEQ, GT;
precedence left PLUS, MINUS;
precedence left MULT, HIGHMULT, DIV, MOD;
precedence nonassoc NOT;


start with program;

// Recognizes "Hello World!", but not much else.
/*program ::= USE IDENTIFIER IDENTIFIER LPAREN IDENTIFIER COLON
  INT LBRACK RBRACK LBRACK RBRACK RPAREN
  LBRACE IDENTIFIER LPAREN STRING_LITERAL RPAREN RBRACE;*/

singleUse           ::= USE IDENTIFIER:id                               {: RESULT = new AstNode("useSpecifier", "", new AstNode("USE", "use"), new AstNode("IDENTIFIER", id.toString())); :}    
                      ;
arrayType           ::= INT brackets:b                  {: RESULT = new AstNode("arrayType", "int"); RESULT.addChild(b); :}
                      | BOOL brackets:b                 {: RESULT = new AstNode("arrayType", "bool"); RESULT.addChild(b); :}
                      ;
arrayLiteral        ::= LBRACE expressions:es RBRACE          {: RESULT = new AstNode("arrayLiteral", ""); RESULT.addGrandChildren(es); :}
                      ;

brackets            ::= brackets:b LBRACK RBRACK            {: RESULT = new AstNode("brackets", ""); RESULT.addGrandChildren(b); RESULT.addChild(new AstNode("LRBRACK", "[]")); :}
                      | LBRACK RBRACK                 {: RESULT = new AstNode("brackets", "", new AstNode("LRBRACK", "[]")); :}
                      | brackets:b LBRACK INTEGER_LITERAL:it RBRACK   {: RESULT = new AstNode("brackets", ""); RESULT.addGrandChildren(b); RESULT.addChild(new AstNode("LRBRACK", "[]", new AstNode("INTEGER_LITERAL", it.toString()))); :}
                      | LBRACK INTEGER_LITERAL:it RBRACK        {: RESULT = new AstNode("brackets", ""); RESULT.addChild(new AstNode("LRBRACK", "[]", new AstNode("INTEGER_LITERAL", it.toString()))); :}
                      ;
type                ::= arrayType:a             {: RESULT = new AstNode("arrayType", "", a); :}
                      | INT                 {: RESULT = new AstNode("INT", "int"); :}
                      | BOOL                {: RESULT = new AstNode("BOOL", "bool"); :}
                      ;
argumentWithType    ::= IDENTIFIER:id COLON type:t      {: RESULT = new AstNode("argumentWithType", id.toString(), t); :}
            ; 
argumentsWithType   ::= argumentsWithType:as COMMA argumentWithType:a {: RESULT = new AstNode("argumentsWithType", ""); RESULT.addGrandChildren(as); RESULT.addChild(a); :}
                      | argumentWithType:a        {: RESULT = new AstNode("argumentsWithType", "", a); :}       
                      ;
argument            ::= BOOLEAN_LITERAL:bl        {: RESULT = new AstNode("BOOLEAN_LITERAL", bl.toString()); :}
                      | INTEGER_LITERAL:il        {: RESULT = new AstNode("INTEGER_LITERAL", il.toString()); :}
                      | CHARACTER_LITERAL:cl      {: RESULT = new AstNode("CHARACTER_LITERAL", cl.toString()); :}
                      | STRING_LITERAL:sl       {: RESULT = new AstNode("STRING_LITERAL", sl.toString()); :}
                      | IDENTIFIER:id         {: RESULT = new AstNode("IDENTIFIER", id.toString()); :}
                      | functionCall:fc         {: RESULT = new AstNode("argument", "", fc); :}
                      | arrayLiteral:al         {: RESULT = new AstNode("argument", "", al); :}
                      ;

functionReturnType  ::= COLON typesList:tl          {: RESULT = new AstNode("functionReturnType", "", tl); :} 
                      |;
typesList           ::= typesList:tl COMMA type:t   {: RESULT = new AstNode("typesList", ""); RESULT.addGrandChildren(tl); RESULT.addChild(t); :}  
            | type:t              {: RESULT = new AstNode("typesList", ""); RESULT.addChild(t); :}
            ;       


method              ::= IDENTIFIER:id LPAREN argumentsWithType:a RPAREN functionReturnType:r
                          LBRACE multipleStatements:s RBRACE      {: RESULT = new AstNode("method", id.toString()); RESULT.addChild(a); RESULT.addChild(r); RESULT.addChild(s); :}
                          ;
multipleStatements  ::= multipleStatements:ms statement:s     {: RESULT = new AstNode("multipleStatements", ""); RESULT.addGrandChildren(ms); RESULT.addChild(s); System.out.println("stmts"); :}
                      | statement:s             {: RESULT = new AstNode("multipleStatements", "", s); :}
                      ;
statement           ::= functionCall optionalSemicolon
                      | assignment optionalSemicolon
                      | ifStatement 
                      | whileStatement 
                      | RETURN expressions optionalSemicolon
                      | argumentWithType optionalSemicolon
                      ; 
optionalSemicolon   ::= SEMICOLON
                      | 
                      ;

operator            ::= EQEQ | GTEQ | LTEQ | NOTEQ | GT | LT | AND | OR 
                      | MULT | PLUS | MINUS | DIV | HIGHMULT | MOD; // incomplete














ifStatement         ::= IF LPAREN expression RPAREN oneOrMorestatements ELSE oneOrMorestatements
                      | IF LPAREN expression RPAREN oneOrMorestatements
                      ;
oneOrMorestatements ::= statement
                      | LBRACE multipleStatements RBRACE
                      ;
whileStatement      ::= WHILE LPAREN expression RPAREN LBRACE multipleStatements RBRACE;


assignment          ::= variables EQ expression                      
                      ;
variables           ::= variables COMMA variable
                      | variable
                      ;
variable            ::= UNDERSCORE
                      | IDENTIFIER
                      | argumentWithType
                      ;
expression          ::= expression operator expression
                      | LPAREN expression RPAREN
                      | argument
                      | NOT expression
                      | MINUS expression
                      ;
expressions         ::= expression
                      | expressions COMMA expression
                      ;
functionCall        ::= IDENTIFIER:id LPAREN expressions:es RPAREN   {: RESULT = new AstNode("functionCall", id.toString()); RESULT.addGrandChildren(es); :}
                      | LENGTH LPAREN IDENTIFIER:id RPAREN              {: RESULT = new AstNode("functionCall", "length", new AstNode("IDENTIFIER", id.toString())); :}
                      ;
program             ::= uses:us  methods:ms                             {: RESULT = new AstNode("program", "", us, ms); :}
                      | uses:us                     {: RESULT = new AstNode("program", "", us, new AstNode("methods", "")); :}
                      | methods:ms                    {: RESULT = new AstNode("program", "", new AstNode("uses", ""), ms); :}
                      |                           {: RESULT = new AstNode("program", "", new AstNode("uses", ""), new AstNode("methods", "")); :}
                      ; 
uses                ::= uses:us singleUse:su                            {: RESULT = new AstNode("uses", ""); RESULT.addGrandChildren(us); RESULT.addChild(su); :}
                      | singleUse:su                                    {: RESULT = new AstNode("uses", "", su); :}
                      ; 
methods             ::= methods:ms method:m               {: RESULT = new AstNode("methods", ""); RESULT.addGrandChildren(ms); RESULT.addChild(m); :} 
                      | method:m                                        {: RESULT = new AstNode("methods", "", m); :}
                      ;