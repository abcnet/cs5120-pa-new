// A stub for a Xi CUP specification.
/* Part of code from http://www2.cs.tum.edu/projekte/cup/examples.php */
package zr54.parser;
import zr54.lexer.*;
import java_cup.runtime.*;
import edu.cornell.cs.cs4120.util.*;
import polyglot.util.*; 


parser code {:
    // Connect this parser to a scanner!
    //Lexer s;
    CodeWriterSExpPrinter printer;
    parser(CodeWriterSExpPrinter printer){ this.printer=printer; }
:}

/* define how to connect to the scanner! */
//init with {: s.init(); :};
//scan with {: return s.next_token(); :};

// You might want to add types to these declarations.
terminal IDENTIFIER, INTEGER_LITERAL, STRING_LITERAL, CHARACTER_LITERAL, BOOLEAN_LITERAL, LPAREN, RPAREN, LBRACE, RBRACE, LBRACK, RBRACK, SEMICOLON, COMMA, COLON, EQ, GT, LT, NOT, MULT, PLUS, MINUS, AND, OR, MOD, IF, EQEQ, GTEQ, LTEQ, NOTEQ, HIGHMULT, INT, BOOL, ELSE, WHILE, LENGTH, RETURN, DIV, USE, UNDERSCORE;

// You might want to add types to these declarations.
nonterminal program, useSpecifier, arrayType, type, argumentWithType, argumentsWithType, argument, functionReturnType, function, multipleStatements, statement, functionCall, blocks, block, typesList, assignment, ifStatement, whileStatement, operator, expression, oneOrMorestatements, brackets, variables, variable, expressions;
// Add more nonterminals here...




precedence nonassoc ELSE;
precedence nonassoc EQ;
precedence left OR;
precedence left AND;
precedence left EQEQ, NOTEQ;
precedence left LT, LTEQ, GTEQ, GT;
precedence left PLUS, MINUS;
precedence left MULT, HIGHMULT, DIV, MOD;
precedence nonassoc NOT;


start with program;

// Recognizes "Hello World!", but not much else.
/*program ::= USE IDENTIFIER IDENTIFIER LPAREN IDENTIFIER COLON
  INT LBRACK RBRACK LBRACK RBRACK RPAREN
  LBRACE IDENTIFIER LPAREN STRING_LITERAL RPAREN RBRACE;*/

useSpecifier        ::= USE IDENTIFIER       {: printer.printAtom("use"); :}
                      ;
arrayType           ::= INT brackets
                      | BOOL brackets
                      ;
brackets            ::= brackets LBRACK RBRACK
                      | LBRACK RBRACK
                      | brackets LBRACK INTEGER_LITERAL RBRACK
                      | LBRACK INTEGER_LITERAL RBRACK
                      ;
type                ::= arrayType
                      | INT
                      | BOOL;
argumentWithType    ::= IDENTIFIER COLON type;
argumentsWithType   ::= argumentsWithType COMMA argumentWithType
                      | argumentWithType;
argument            ::= BOOLEAN_LITERAL
                      | INTEGER_LITERAL
                      | CHARACTER_LITERAL
                      | STRING_LITERAL
                      | IDENTIFIER
                      | functionCall
                      ;

functionReturnType  ::= COLON type
                      | COLON LPAREN typesList RPAREN
                      |;
typesList           ::= typesList COMMA type | type;


function            ::= IDENTIFIER LPAREN argumentsWithType RPAREN functionReturnType
                          LBRACE multipleStatements RBRACE    {: printer.printAtom("Function"); :}
                          ;
multipleStatements  ::= multipleStatements statement
                      | statement;
statement           ::= functionCall | assignment | ifStatement | whileStatement 
                      | RETURN LPAREN expressions RPAREN
                      | assignment SEMICOLON 
                      | RETURN LPAREN expressions RPAREN SEMICOLON
                      | functionCall SEMICOLON
                      | argumentWithType
                      | argumentWithType SEMICOLON 
                      ; 
operator            ::= EQEQ | GTEQ | LTEQ | NOTEQ | GT | LT | AND | OR 
                      | MULT | PLUS | MINUS | DIV | HIGHMULT | MOD; // incomplete

ifStatement         ::= IF LPAREN expression RPAREN oneOrMorestatements ELSE oneOrMorestatements
                      | IF LPAREN expression RPAREN oneOrMorestatements
                      ;
oneOrMorestatements ::= statement
                      | LBRACE multipleStatements RBRACE
                      ;
whileStatement      ::= WHILE LPAREN expression RPAREN LBRACE multipleStatements RBRACE;
/*assignment          ::= variable EQ LPAREN expressions COMMA expression RPAREN
                      | LPAREN variables RPAREN EQ LPAREN expressions COMMA expression RPAREN
                      | variable EQ expression
                      | LPAREN variables RPAREN EQ functionCall
                      ;*/ //not resolved
assignment          ::=variable EQ expression

                      ;
variables           ::= variables COMMA variable
                      | variable
                      ;
variable            ::= UNDERSCORE
                      | IDENTIFIER
                      | argumentWithType
                      ;
expression          ::= expression operator expression
                      | LPAREN expression RPAREN
                      | argument
                      | NOT expression
                      | MINUS expression
                      ;
expressions         ::= expression
                      | expressions COMMA expression
                      ;
functionCall        ::= IDENTIFIER LPAREN expressions RPAREN
                      | LENGTH LPAREN IDENTIFIER RPAREN
                      ;
program             ::= blocks; 
blocks              ::= blocks block
                      | block;
block               ::= useSpecifier | function;
